# Private runtime data: login, messages, saved content, rate limits
data/*
!data/.htaccess

# Local settings with the setup code (use cms/config.example.php as template)
cms/config.php

# Temporary files written during publishing
*.tmp-*

# Pages generated by the CMS on the server (built by index.php / the admin)
/index.html
/privacy.html
/robots.txt
/sitemap.xml
